# Public URL used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Turso / LibSQL. Omit locally to use portfolio.db.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=

# Auth.js + GitHub OAuth.
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ADMIN_GITHUB_USER_ID=70781126

# Automatically provided when a Vercel Blob store is linked.
BLOB_READ_WRITE_TOKEN=

# Existing EmailJS service, now called only from the server.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
